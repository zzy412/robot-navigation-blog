{"config":{"lang":["en"],"separator":"[\\s\\u200b\\u3000\\-\u3001\u3002\uff0c\uff0e\uff1f\uff01\uff1b]+","pipeline":["stemmer"],"fields":{"title":{"boost":1000.0},"text":{"boost":1.0},"tags":{"boost":1000000.0}}},"docs":[{"location":"","title":"Welcome to MkDocs","text":"<p>For full documentation visit mkdocs.org.</p>"},{"location":"#commands","title":"Commands","text":"<ul> <li><code>mkdocs new [dir-name]</code> - Create a new project.</li> <li><code>mkdocs serve</code> - Start the live-reloading docs server.</li> <li><code>mkdocs build</code> - Build the documentation site.</li> <li><code>mkdocs -h</code> - Print help message and exit.</li> </ul>"},{"location":"#project-layout","title":"Project layout","text":"<pre><code>mkdocs.yml    # The configuration file.\ndocs/\n    index.md  # The documentation homepage.\n    ...       # Other markdown pages, images and other files.\n</code></pre>"},{"location":"algorithms/","title":"\u5f85\u66f4\u65b0","text":""},{"location":"algorithms/hybrid-a-star/","title":"\u4ece A* \u5230 Hybrid A*\uff1a\u963f\u514b\u66fc\u65e0\u4eba\u8f66\u8def\u5f84\u89c4\u5212\u5b9e\u9a8c","text":""},{"location":"algorithms/hybrid-a-star/#1","title":"1. \u7814\u7a76\u80cc\u666f","text":"<p>\u5728\u79fb\u52a8\u673a\u5668\u4eba\u81ea\u4e3b\u5bfc\u822a\u4e2d\uff0c\u8def\u5f84\u89c4\u5212\u7b97\u6cd5\u8d1f\u8d23\u6839\u636e\u73af\u5883\u5730\u56fe\u3001\u8f66\u8f86\u521d\u59cb\u4f4d\u7f6e\u548c\u76ee\u6807\u4f4d\u7f6e\uff0c\u751f\u6210\u4e00\u6761\u6ee1\u8db3\u7ea6\u675f\u6761\u4ef6\u7684\u53ef\u884c\u8def\u5f84\u3002</p> <p>\u4f20\u7edf A* \u7b97\u6cd5\u80fd\u591f\u5728\u4e8c\u7ef4\u6805\u683c\u5730\u56fe\u4e2d\u5bfb\u627e\u8def\u5f84\uff0c\u4f46\u901a\u5e38\u5c06\u673a\u5668\u4eba\u7b80\u5316\u4e3a\u8d28\u70b9\uff0c\u53ea\u8003\u8651\u4f4d\u7f6e\u53d8\u5316\uff0c\u6ca1\u6709\u76f4\u63a5\u8003\u8651\u8f66\u8f86\u822a\u5411\u89d2\u53ca\u6700\u5c0f\u8f6c\u5f2f\u534a\u5f84\u7b49\u8fd0\u52a8\u5b66\u7ea6\u675f\u3002</p> <p>\u5bf9\u4e8e\u91c7\u7528\u963f\u514b\u66fc\u8f6c\u5411\u7ed3\u6784\u7684\u8f6e\u5f0f\u65e0\u4eba\u8f66\uff0c\u8fd9\u79cd\u7b80\u5316\u53ef\u80fd\u5bfc\u81f4\u89c4\u5212\u51fa\u7684\u8def\u5f84\u65e0\u6cd5\u88ab\u8f66\u8f86\u76f4\u63a5\u6267\u884c\u3002</p> <p>\u56e0\u6b64\uff0c\u672c\u9879\u76ee\u5728\u5b9e\u73b0\u57fa\u7840 A* \u7b97\u6cd5\u540e\uff0c\u8fdb\u4e00\u6b65\u5b9e\u73b0\u4e86 Hybrid A* \u8def\u5f84\u89c4\u5212\u7b97\u6cd5\uff0c\u5e76\u7ed3\u5408 Pure Pursuit \u63a7\u5236\u5668\u5f00\u5c55\u8f68\u8ff9\u8ddf\u8e2a\u4eff\u771f\u5b9e\u9a8c\u3002</p>"},{"location":"algorithms/hybrid-a-star/#2-a","title":"2. A* \u8def\u5f84\u89c4\u5212\u7b97\u6cd5","text":"<p>A* \u662f\u4e00\u79cd\u57fa\u4e8e\u542f\u53d1\u5f0f\u641c\u7d22\u7684\u8def\u5f84\u89c4\u5212\u7b97\u6cd5\uff0c\u5176\u8bc4\u4ef7\u51fd\u6570\u4e3a\uff1a</p> \\[ f(n)=g(n)+h(n) \\] <p>\u5176\u4e2d\uff1a</p> <ul> <li>\\(g(n)\\)\uff1a\u4ece\u8d77\u70b9\u5230\u5f53\u524d\u8282\u70b9\u7684\u7d2f\u8ba1\u8def\u5f84\u4ee3\u4ef7\u3002</li> <li>\\(h(n)\\)\uff1a\u4ece\u5f53\u524d\u8282\u70b9\u5230\u76ee\u6807\u8282\u70b9\u7684\u542f\u53d1\u5f0f\u4f30\u8ba1\u4ee3\u4ef7\u3002</li> <li>\\(f(n)\\)\uff1a\u7ecf\u8fc7\u5f53\u524d\u8282\u70b9\u5230\u8fbe\u76ee\u6807\u7684\u4f30\u8ba1\u603b\u4ee3\u4ef7\u3002</li> </ul> <p>A* \u901a\u8fc7\u4f18\u5148\u6269\u5c55\u8bc4\u4ef7\u51fd\u6570\u8f83\u5c0f\u7684\u8282\u70b9\uff0c\u63d0\u9ad8\u76ee\u6807\u5bfc\u5411\u7684\u641c\u7d22\u6548\u7387\u3002</p> <p>\u7136\u800c\uff0c\u4f20\u7edf\u4e8c\u7ef4\u6805\u683c A* \u4e3b\u8981\u89e3\u51b3\u51e0\u4f55\u8def\u5f84\u641c\u7d22\u95ee\u9898\uff0c\u751f\u6210\u7684\u8def\u5f84\u4e0d\u4e00\u5b9a\u6ee1\u8db3\u963f\u514b\u66fc\u8f66\u8f86\u7684\u8f6c\u5411\u7ea6\u675f\u3002</p>"},{"location":"algorithms/hybrid-a-star/#3","title":"3. \u963f\u514b\u66fc\u8f66\u8f86\u8fd0\u52a8\u5b66\u6a21\u578b","text":"<p>\u672c\u9879\u76ee\u91c7\u7528\u8fd0\u52a8\u5b66\u81ea\u884c\u8f66\u6a21\u578b\u63cf\u8ff0\u963f\u514b\u66fc\u8f66\u8f86\u8fd0\u52a8\uff1a</p> \\[ \\dot{x}=v\\cos\\theta \\] \\[ \\dot{y}=v\\sin\\theta \\] \\[ \\dot{\\theta}=\\frac{v}{L}\\tan\\delta \\] <p>\u5176\u4e2d\uff1a</p> <ul> <li>\\(x,y\\)\uff1a\u8f66\u8f86\u4f4d\u7f6e\u3002</li> <li>\\(\\theta\\)\uff1a\u8f66\u8f86\u822a\u5411\u89d2\u3002</li> <li>\\(v\\)\uff1a\u8f66\u8f86\u884c\u9a76\u901f\u5ea6\u3002</li> <li>\\(L\\)\uff1a\u8f66\u8f86\u8f74\u8ddd\u3002</li> <li>\\(\\delta\\)\uff1a\u524d\u8f6e\u8f6c\u5411\u89d2\u3002</li> </ul> <p>\u7531\u4e8e\u8f6c\u5411\u89d2\u53d7\u5230\u673a\u68b0\u7ed3\u6784\u9650\u5236\uff0c\u8f66\u8f86\u5b58\u5728\u6700\u5c0f\u8f6c\u5f2f\u534a\u5f84\uff1a</p> \\[ R_{\\min}=\\frac{L}{\\tan\\delta_{\\max}} \\] <p>\u56e0\u6b64\uff0c\u4e0d\u80fd\u7b80\u5355\u5730\u5c06\u4e8c\u7ef4\u6805\u683c\u641c\u7d22\u8def\u5f84\u76f4\u63a5\u4f5c\u4e3a\u8f66\u8f86\u53ef\u6267\u884c\u8f68\u8ff9\u3002</p>"},{"location":"algorithms/hybrid-a-star/#4-hybrid-a","title":"4. Hybrid A* \u7b97\u6cd5","text":"<p>Hybrid A* \u5728\u4f20\u7edf A* \u7684\u57fa\u7840\u4e0a\uff0c\u5c06\u8f66\u8f86\u822a\u5411\u89d2\u548c\u8fd0\u52a8\u5b66\u6a21\u578b\u5f15\u5165\u72b6\u6001\u6269\u5c55\u8fc7\u7a0b\u3002</p> <p>\u5728\u641c\u7d22\u8fc7\u7a0b\u4e2d\uff0c\u4e0d\u518d\u7b80\u5355\u5730\u6309\u7167\u6805\u683c\u7684\u56db\u90bb\u57df\u6216\u516b\u90bb\u57df\u6269\u5c55\u8282\u70b9\uff0c\u800c\u662f\u6839\u636e\u4e00\u7ec4\u79bb\u6563\u63a7\u5236\u8f93\u5165\uff0c\u901a\u8fc7\u8f66\u8f86\u8fd0\u52a8\u5b66\u6a21\u578b\u8fdb\u884c\u77ed\u65f6\u95f4\u524d\u5411\u4eff\u771f\uff0c\u751f\u6210\u5177\u6709\u8fd0\u52a8\u5b66\u610f\u4e49\u7684\u5019\u9009\u8f68\u8ff9\u3002</p> <p>\u672c\u9879\u76ee\u4e3b\u8981\u5b9e\u73b0\u4e86\uff1a</p> <ol> <li>\u57fa\u4e8e\u4f4d\u7f6e\u4e0e\u822a\u5411\u89d2\u7684\u72b6\u6001\u8868\u793a\u3002</li> <li>\u79bb\u6563\u8f6c\u5411\u63a7\u5236\u8f93\u5165\u4e0e\u8fd0\u52a8\u57fa\u5143\u751f\u6210\u3002</li> <li>\u57fa\u4e8e\u8f66\u8f86\u8fd0\u52a8\u5b66\u6a21\u578b\u7684\u72b6\u6001\u6269\u5c55\u3002</li> <li>\u57fa\u4e8e\u77e9\u5f62\u8f66\u4f53\u8f6e\u5ed3\u7684\u78b0\u649e\u68c0\u6d4b\u3002</li> <li>\u542f\u53d1\u5f0f\u641c\u7d22\u4e0e\u8def\u5f84\u91cd\u5efa\u3002</li> </ol> <p>\u8be5\u65b9\u6cd5\u80fd\u591f\u4f7f\u89c4\u5212\u7ed3\u679c\u66f4\u52a0\u7b26\u5408\u963f\u514b\u66fc\u8f66\u8f86\u7684\u8fd0\u52a8\u7279\u6027\u3002</p>"},{"location":"algorithms/hybrid-a-star/#5-c","title":"5. C++ \u4eff\u771f\u5b9e\u73b0","text":"<p>\u672c\u9879\u76ee\u4f7f\u7528 C++17 \u548c CMake \u5f00\u53d1\uff0c\u4e3b\u8981\u6a21\u5757\u5305\u62ec\uff1a</p> \u6a21\u5757 \u529f\u80fd VehicleModel \u963f\u514b\u66fc\u8f66\u8f86\u8fd0\u52a8\u5b66\u6a21\u578b GridMap \u5730\u56fe\u8868\u793a\u53ca\u78b0\u649e\u68c0\u6d4b AStar \u57fa\u7840 A* \u641c\u7d22 HybridAStar \u8003\u8651\u8f66\u8f86\u8fd0\u52a8\u7ea6\u675f\u7684\u8def\u5f84\u89c4\u5212 PurePursuit \u8f66\u8f86\u8def\u5f84\u8ddf\u8e2a\u63a7\u5236 Visualization \u5b9e\u9a8c\u7ed3\u679c\u53ef\u89c6\u5316 <p>\u5728\u4e8c\u7ef4\u5730\u56fe\u4e2d\u5206\u522b\u8fd0\u884c A* \u548c Hybrid A*\uff0c\u5e76\u5229\u7528 Pure Pursuit \u5bf9\u89c4\u5212\u8def\u5f84\u5f00\u5c55\u8ddf\u8e2a\u5b9e\u9a8c\u3002</p> <p></p> <p>\u56fe1\uff1a\u57fa\u4e8e A\u3001Hybrid A* \u4e0e Pure Pursuit \u7684\u8def\u5f84\u89c4\u5212\u53ca\u8f68\u8ff9\u8ddf\u8e2a\u4eff\u771f\u7ed3\u679c*</p>"},{"location":"algorithms/hybrid-a-star/#6","title":"6. \u5b9e\u9a8c\u7ed3\u679c\u4e0e\u5206\u6790","text":"<p>\u5728\u5df2\u6709\u4eff\u771f\u573a\u666f\u4e2d\uff0c\u4e24\u79cd\u7b97\u6cd5\u5747\u80fd\u591f\u8fdb\u884c\u8def\u5f84\u641c\u7d22\uff0c\u4f46\u89c4\u5212\u7ed3\u679c\u5177\u6709\u4e0d\u540c\u7279\u70b9\u3002</p> <p>A* \u4e3b\u8981\u5173\u6ce8\u4e8c\u7ef4\u51e0\u4f55\u8def\u5f84\uff0c\u641c\u7d22\u6548\u7387\u8f83\u9ad8\uff0c\u4f46\u53ef\u80fd\u751f\u6210\u4e0d\u7b26\u5408\u8f66\u8f86\u8f6c\u5411\u80fd\u529b\u7684\u8def\u5f84\u3002</p> <p>Hybrid A* \u7531\u4e8e\u5728\u72b6\u6001\u6269\u5c55\u8fc7\u7a0b\u4e2d\u52a0\u5165\u8f66\u8f86\u822a\u5411\u89d2\u548c\u8f6c\u5411\u63a7\u5236\uff0c\u80fd\u591f\u751f\u6210\u6ee1\u8db3\u5f53\u524d\u8fd0\u52a8\u5b66\u6a21\u578b\u7ea6\u675f\u7684\u53c2\u8003\u8def\u5f84\uff0c\u4f46\u76f8\u5e94\u5730\u9700\u8981\u66f4\u591a\u641c\u7d22\u8ba1\u7b97\u3002</p> <p>\u8fdb\u4e00\u6b65\u52a0\u5165 Pure Pursuit \u540e\uff0c\u53ef\u4ee5\u6839\u636e\u53c2\u8003\u8def\u5f84\u8ba1\u7b97\u8f66\u8f86\u8f6c\u5411\u89d2\uff0c\u5e76\u901a\u8fc7\u8f66\u8f86\u8fd0\u52a8\u5b66\u6a21\u578b\u5f97\u5230\u5b9e\u9645\u8ddf\u8e2a\u8f68\u8ff9\u3002</p> <p>\u5b9e\u9a8c\u8bf4\u660e\uff0c\u8def\u5f84\u89c4\u5212\u548c\u8f68\u8ff9\u8ddf\u8e2a\u662f\u4e24\u4e2a\u76f8\u4e92\u8054\u7cfb\u4f46\u4e0d\u5b8c\u5168\u76f8\u540c\u7684\u95ee\u9898\u3002\u89c4\u5212\u8def\u5f84\u7684\u53ef\u884c\u6027\u5e76\u4e0d\u610f\u5473\u7740\u8f66\u8f86\u5728\u6709\u9650\u8f6c\u5411\u54cd\u5e94\u4e0b\u80fd\u591f\u51c6\u786e\u8ddf\u8e2a\u3002</p>"},{"location":"algorithms/hybrid-a-star/#7","title":"7. \u9636\u6bb5\u6027\u603b\u7ed3","text":"<p>\u901a\u8fc7\u672c\u6b21\u5b9e\u9a8c\uff0c\u6211\u5b8c\u6210\u4e86\u4ece\u57fa\u7840 A* \u8def\u5f84\u641c\u7d22\u5230\u8003\u8651\u8f66\u8f86\u8fd0\u52a8\u5b66\u7ea6\u675f\u7684 Hybrid A* \u8def\u5f84\u89c4\u5212\u7684\u5b66\u4e60\u4e0e\u5b9e\u73b0\uff0c\u5e76\u521d\u6b65\u5efa\u7acb\u4e86\u8def\u5f84\u89c4\u5212\u4e0e\u8f68\u8ff9\u8ddf\u8e2a\u4e00\u4f53\u5316\u7684 C++ \u4eff\u771f\u6d41\u7a0b\u3002</p> <p>\u4e0b\u4e00\u9636\u6bb5\u5c06\u8fdb\u4e00\u6b65\u5b8c\u5584 ROS 2 \u5e73\u53f0\u4e0b\u7684\u5b9e\u65f6\u95ed\u73af\u8f68\u8ff9\u8ddf\u8e2a\uff0c\u5e76\u7814\u7a76\u8f6c\u5411\u6267\u884c\u5668\u7ea6\u675f\u4e0b\u7684\u901f\u5ea6\u89c4\u5212\u4e0e\u8f68\u8ff9\u8ddf\u8e2a\u534f\u540c\u4f18\u5316\u3002</p>"},{"location":"algorithms/hybrid-a-star/#_1","title":"\u53c2\u8003\u5b66\u4e60\u8d44\u6e90","text":"<ul> <li>\u300aMotion Planning for Mobile Robots\u300bLecture 2\uff1aSearch-based Path Finding</li> <li>\u300aMotion Planning for Mobile Robots\u300bLecture 4\uff1aKinodynamic Path Finding</li> <li>PythonRobotics</li> <li>Hybrid A* Path Planner</li> </ul>"},{"location":"courses/","title":"\u79fb\u52a8\u673a\u5668\u4eba\u8fd0\u52a8\u89c4\u5212\u8bfe\u7a0b\u5b66\u4e60","text":"<p>\u672c\u680f\u76ee\u8bb0\u5f55\u300aMotion Planning for Mobile Robots\u300b\u8bfe\u7a0b\u7684\u5b66\u4e60\u5185\u5bb9\u3002\u8bfe\u7a0b\u4e3b\u8981\u6d89\u53ca\u673a\u5668\u4eba\u8fd0\u52a8\u89c4\u5212\u7684\u57fa\u7840\u7406\u8bba\u3001\u8def\u5f84\u641c\u7d22\u7b97\u6cd5\u3001\u91c7\u6837\u5f0f\u89c4\u5212\u65b9\u6cd5\u548c\u8003\u8651\u8fd0\u52a8\u7ea6\u675f\u7684\u8def\u5f84\u89c4\u5212\u3002</p>"},{"location":"courses/#lecture-1","title":"Lecture 1\uff1a\u79fb\u52a8\u673a\u5668\u4eba\u8fd0\u52a8\u89c4\u5212\u6982\u8ff0","text":"<p>\u4e3b\u8981\u5b66\u4e60\u673a\u5668\u4eba\u81ea\u4e3b\u5bfc\u822a\u7cfb\u7edf\u7684\u57fa\u672c\u67b6\u6784\uff0c\u7406\u89e3\u73af\u5883\u611f\u77e5\u3001\u5b9a\u4f4d\u3001\u5efa\u56fe\u3001\u8def\u5f84\u89c4\u5212\u4e0e\u63a7\u5236\u4e4b\u95f4\u7684\u8054\u7cfb\u3002\u540c\u65f6\u5b66\u4e60\u8fd0\u52a8\u89c4\u5212\u7684\u524d\u7aef\u8def\u5f84\u641c\u7d22\u4e0e\u540e\u7aef\u8f68\u8ff9\u4f18\u5316\uff0c\u4ee5\u53ca\u5360\u636e\u6805\u683c\u3001OctoMap\u3001\u70b9\u4e91\u3001TSDF \u548c ESDF \u7b49\u5730\u56fe\u8868\u793a\u65b9\u6cd5\u3002</p>"},{"location":"courses/#lecture-2","title":"Lecture 2\uff1a\u57fa\u4e8e\u641c\u7d22\u7684\u8def\u5f84\u89c4\u5212","text":"<p>\u4e3b\u8981\u5b66\u4e60\u914d\u7f6e\u7a7a\u95f4\u3001\u56fe\u641c\u7d22\u57fa\u7840\uff0c\u4ee5\u53ca BFS\u3001DFS\u3001Dijkstra\u3001A\u3001Weighted A \u548c Jump Point Search\uff08JPS\uff09\u7b49\u7b97\u6cd5\u3002</p> <p>\u5176\u4e2d\uff0cA* \u7b97\u6cd5\u901a\u8fc7\u7ed3\u5408\u7d2f\u8ba1\u8def\u5f84\u4ee3\u4ef7\u4e0e\u542f\u53d1\u5f0f\u4f30\u8ba1\u8fdb\u884c\u641c\u7d22\uff1a</p> \\[ f(n)=g(n)+h(n) \\] <p>\u8fd9\u90e8\u5206\u77e5\u8bc6\u5df2\u7ecf\u5e94\u7528\u4e8e\u5f53\u524d C++ \u9879\u76ee\u4e2d\u7684 A* \u4e0e Hybrid A* \u5b9e\u73b0\u3002</p>"},{"location":"courses/#lecture-3","title":"Lecture 3\uff1a\u57fa\u4e8e\u91c7\u6837\u7684\u8def\u5f84\u89c4\u5212","text":"<p>\u4e3b\u8981\u5b66\u4e60\u6982\u7387\u8def\u7ebf\u56fe PRM\u3001\u5feb\u901f\u6269\u5c55\u968f\u673a\u6811 RRT\u3001RRT-Connect\u3001RRT* \u548c Informed RRT* \u7b49\u7b97\u6cd5\u3002</p> <p>\u91cd\u70b9\u7406\u89e3\u968f\u673a\u91c7\u6837\u3001\u6700\u8fd1\u90bb\u8282\u70b9\u641c\u7d22\u3001\u78b0\u649e\u68c0\u6d4b\u53ca\u641c\u7d22\u6811\u4f18\u5316\u7b49\u57fa\u672c\u601d\u60f3\u3002</p> <p>\u8fd9\u90e8\u5206\u76ee\u524d\u4ee5\u7406\u8bba\u5b66\u4e60\u4e3a\u4e3b\uff0c\u540e\u7eed\u8003\u8651\u4f7f\u7528 RRT* \u4f5c\u4e3a\u8def\u5f84\u89c4\u5212\u5bf9\u7167\u7b97\u6cd5\u3002</p>"},{"location":"courses/#lecture-4","title":"Lecture 4\uff1a\u8003\u8651\u8fd0\u52a8\u7ea6\u675f\u7684\u8def\u5f84\u89c4\u5212","text":"<p>\u4e3b\u8981\u5b66\u4e60 State Lattice\u3001\u8fd0\u52a8\u57fa\u5143\u3001\u8fb9\u754c\u503c\u95ee\u9898\u3001Kinodynamic RRT* \u548c Hybrid A*\u3002</p> <p>\u5bf9\u4e8e\u91c7\u7528\u963f\u514b\u66fc\u8f6c\u5411\u7ed3\u6784\u7684\u8f66\u8f86\uff0c\u8def\u5f84\u89c4\u5212\u4e0d\u4ec5\u9700\u8981\u907f\u5f00\u969c\u788d\u7269\uff0c\u8fd8\u5fc5\u987b\u8003\u8651\u8f66\u8f86\u7684\u975e\u5b8c\u6574\u8fd0\u52a8\u7ea6\u675f\u548c\u6700\u5c0f\u8f6c\u5f2f\u534a\u5f84\u3002</p> <p>\u672c\u9879\u76ee\u5df2\u5c06\u76f8\u5173\u7406\u8bba\u5e94\u7528\u4e8e Hybrid A* \u8def\u5f84\u89c4\u5212\u4e0e\u8f66\u8f86\u8fd0\u52a8\u5b66\u4eff\u771f\u3002</p>"},{"location":"courses/#_2","title":"\u8bfe\u7a0b\u5b66\u4e60\u603b\u7ed3","text":"<p>\u901a\u8fc7\u524d\u56db\u8bb2\u7684\u5b66\u4e60\uff0c\u9010\u6b65\u5efa\u7acb\u4e86\u4ece\u57fa\u7840\u56fe\u641c\u7d22\u3001\u968f\u673a\u91c7\u6837\u89c4\u5212\u5230\u8003\u8651\u8f66\u8f86\u8fd0\u52a8\u7ea6\u675f\u7684\u8def\u5f84\u89c4\u5212\u77e5\u8bc6\u4f53\u7cfb\u3002</p> <p>\u540e\u7eed\u5c06\u7ee7\u7eed\u7ed3\u5408 C++ \u548c ROS 2 \u9879\u76ee\uff0c\u901a\u8fc7\u4ee3\u7801\u5b9e\u73b0\u3001\u7b97\u6cd5\u53ef\u89c6\u5316\u548c\u5bf9\u6bd4\u5b9e\u9a8c\u52a0\u6df1\u5bf9\u76f8\u5173\u65b9\u6cd5\u7684\u7406\u89e3\u3002</p>"},{"location":"papers/","title":"\u673a\u5668\u4eba\u5bfc\u822a\u4e0e\u8fd0\u52a8\u89c4\u5212\u8bba\u6587\u9605\u8bfb","text":"<p>\u672c\u680f\u76ee\u4e3b\u8981\u8bb0\u5f55\u673a\u5668\u4eba\u8fd0\u52a8\u89c4\u5212\u3001\u8f68\u8ff9\u4f18\u5316\u3001SLAM \u548c\u5206\u5c42\u5bfc\u822a\u65b9\u5411\u7684\u8bba\u6587\u5b66\u4e60\u7b14\u8bb0\u3002</p> <p>\u76ee\u524d\u91cd\u70b9\u9605\u8bfb\u4e86\u4ee5\u4e0b\u4e94\u7bc7\u8bba\u6587\u3002</p>"},{"location":"papers/#1-fast-planner","title":"1. Fast-Planner","text":"<p>\u8bba\u6587\uff1a Robust and Efficient Quadrotor Trajectory Generation for Fast Autonomous Flight</p> <p>\u7814\u7a76\u65b9\u5411\uff1a \u52a8\u529b\u5b66\u7ea6\u675f\u641c\u7d22\u4e0e\u8f68\u8ff9\u4f18\u5316</p> <p>\u8bba\u6587\u7ed3\u5408 Kinodynamic Path Searching\u3001B-spline \u8f68\u8ff9\u4f18\u5316\u548c\u65f6\u95f4\u5206\u914d\u65b9\u6cd5\uff0c\u5b9e\u73b0\u5feb\u901f\u4e14\u6ee1\u8db3\u8fd0\u52a8\u7ea6\u675f\u7684\u8f68\u8ff9\u751f\u6210\u3002</p> <p>\u91cd\u70b9\u5b66\u4e60\u5185\u5bb9\u5305\u62ec\u8fd0\u52a8\u57fa\u5143\u3001\u542f\u53d1\u5f0f\u641c\u7d22\u3001\u8f68\u8ff9\u5e73\u6ed1\u548c\u52a8\u6001\u53ef\u884c\u6027\u3002</p> <p>\u5bf9\u5f53\u524d\u9879\u76ee\u7684\u542f\u53d1\uff1a \u53ef\u4ee5\u5728 Hybrid A* \u751f\u6210\u53c2\u8003\u8def\u5f84\u540e\uff0c\u7ee7\u7eed\u8003\u8651\u8f68\u8ff9\u4f18\u5316\u548c\u901f\u5ea6\u5206\u914d\u3002</p>"},{"location":"papers/#2-ego-planner","title":"2. EGO-Planner","text":"<p>\u8bba\u6587\uff1a EGO-Planner: An ESDF-free Gradient-based Local Planner for Quadrotors</p> <p>\u7814\u7a76\u65b9\u5411\uff1a \u9ad8\u6548\u5c40\u90e8\u8f68\u8ff9\u4f18\u5316</p> <p>\u8bba\u6587\u5229\u7528\u65e0\u78b0\u649e\u5f15\u5bfc\u8def\u5f84\u6784\u9020\u907f\u969c\u68af\u5ea6\uff0c\u907f\u514d\u7ef4\u62a4\u5b8c\u6574 ESDF\uff0c\u5e76\u901a\u8fc7 B-spline \u4f18\u5316\u6539\u5584\u8f68\u8ff9\u5e73\u6ed1\u6027\u3001\u5b89\u5168\u6027\u548c\u52a8\u6001\u53ef\u884c\u6027\u3002</p> <p>\u5bf9\u5f53\u524d\u9879\u76ee\u7684\u542f\u53d1\uff1a \u4e3a\u540e\u7eed\u7814\u7a76\u5c40\u90e8\u907f\u969c\u3001\u8f68\u8ff9\u4f18\u5316\u53ca\u8ba1\u7b97\u6548\u7387\u63d0\u4f9b\u53c2\u8003\u3002</p>"},{"location":"papers/#3-minco-gcopter","title":"3. MINCO / GCOPTER","text":"<p>\u8bba\u6587\uff1a Geometrically Constrained Trajectory Optimization for Multicopters</p> <p>\u7814\u7a76\u65b9\u5411\uff1a \u53d7\u7ea6\u675f\u8f68\u8ff9\u4f18\u5316</p> <p>\u8bba\u6587\u63d0\u51fa MINCO \u8f68\u8ff9\u8868\u793a\uff0c\u5b9e\u73b0\u7a7a\u95f4\u8f68\u8ff9\u5f62\u72b6\u4e0e\u65f6\u95f4\u5206\u914d\u7684\u8054\u5408\u4f18\u5316\uff0c\u5e76\u8003\u8651\u51e0\u4f55\u5b89\u5168\u7ea6\u675f\u548c\u7cfb\u7edf\u52a8\u6001\u7ea6\u675f\u3002</p> <p>\u5bf9\u5f53\u524d\u9879\u76ee\u7684\u542f\u53d1\uff1a \u4e3a\u7814\u7a76\u884c\u9a76\u901f\u5ea6\u3001\u8f68\u8ff9\u8ddf\u8e2a\u7cbe\u5ea6\u4e0e\u8f66\u8f86\u8fd0\u52a8\u7ea6\u675f\u4e4b\u95f4\u7684\u534f\u8c03\u5173\u7cfb\u63d0\u4f9b\u7406\u8bba\u53c2\u8003\u3002</p>"},{"location":"papers/#4-fast-lio2","title":"4. FAST-LIO2","text":"<p>\u8bba\u6587\uff1a FAST-LIO2: Fast Direct LiDAR-inertial Odometry</p> <p>\u7814\u7a76\u65b9\u5411\uff1a \u6fc0\u5149\u60ef\u6027\u91cc\u7a0b\u8ba1\u4e0e\u5b9e\u65f6\u5efa\u56fe</p> <p>\u8bba\u6587\u5229\u7528\u6fc0\u5149\u96f7\u8fbe\u548c IMU \u7684\u7d27\u8026\u5408\u72b6\u6001\u4f30\u8ba1\u3001\u539f\u59cb\u70b9\u4e91\u76f4\u63a5\u914d\u51c6\u53ca ikd-Tree \u589e\u91cf\u5730\u56fe\u7ba1\u7406\uff0c\u63d0\u9ad8\u5b9a\u4f4d\u5efa\u56fe\u6548\u7387\u3002</p> <p>\u5bf9\u5f53\u524d\u9879\u76ee\u7684\u542f\u53d1\uff1a \u4e3a\u672a\u6765\u63a5\u5165\u771f\u5b9e\u4f20\u611f\u5668\u3001\u5b9e\u73b0\u673a\u5668\u4eba\u5b9a\u4f4d\u4e0e\u5730\u56fe\u6784\u5efa\u63d0\u4f9b\u53c2\u8003\u3002</p>"},{"location":"papers/#5-sysnav","title":"5. SysNav","text":"<p>\u8bba\u6587\uff1a SysNav: Multi-Level Systematic Cooperation Enables Real-World, Cross-Embodiment Object Navigation</p> <p>\u7814\u7a76\u65b9\u5411\uff1a \u5206\u5c42\u8bed\u4e49\u5bfc\u822a</p> <p>\u8bba\u6587\u5c06\u76ee\u6807\u5bfc\u822a\u5212\u5206\u4e3a\u9ad8\u5c42\u8bed\u4e49\u63a8\u7406\u3001\u4e2d\u5c42\u5bfc\u822a\u89c4\u5212\u4e0e\u5e95\u5c42\u8fd0\u52a8\u63a7\u5236\uff0c\u7ed3\u5408\u7ed3\u6784\u5316\u573a\u666f\u8868\u793a\u548c\u89c6\u89c9\u8bed\u8a00\u6a21\u578b\u5b9e\u73b0\u590d\u6742\u73af\u5883\u4e2d\u7684\u76ee\u6807\u641c\u7d22\u3002</p> <p>\u5bf9\u5f53\u524d\u9879\u76ee\u7684\u542f\u53d1\uff1a \u6709\u52a9\u4e8e\u7406\u89e3\u81ea\u4e3b\u5bfc\u822a\u7cfb\u7edf\u7684\u5206\u5c42\u6a21\u5757\u8bbe\u8ba1\uff0c\u5e76\u4e3a\u540e\u7eed\u6269\u5c55\u8bed\u4e49\u5bfc\u822a\u4efb\u52a1\u63d0\u4f9b\u601d\u8def\u3002</p>"},{"location":"papers/#_2","title":"\u9605\u8bfb\u603b\u7ed3","text":"<p>\u4ee5\u4e0a\u8bba\u6587\u5206\u522b\u4ece\u8f68\u8ff9\u89c4\u5212\u3001\u5c40\u90e8\u4f18\u5316\u3001\u72b6\u6001\u4f30\u8ba1\u548c\u7cfb\u7edf\u7ea7\u5bfc\u822a\u7b49\u89d2\u5ea6\uff0c\u5c55\u793a\u4e86\u673a\u5668\u4eba\u81ea\u4e3b\u5bfc\u822a\u4e2d\u7684\u5173\u952e\u6280\u672f\u3002</p> <p>\u5f53\u524d\u9879\u76ee\u4e3b\u8981\u4ee5\u963f\u514b\u66fc\u65e0\u4eba\u8f66\u8def\u5f84\u89c4\u5212\u548c\u8f68\u8ff9\u8ddf\u8e2a\u4e3a\u7814\u7a76\u91cd\u70b9\uff0c\u56e0\u6b64\u5c06\u4f18\u5148\u501f\u9274 Fast-Planner\u3001EGO-Planner \u548c MINCO/GCOPTER \u7684\u89c4\u5212\u4f18\u5316\u601d\u60f3\uff0c\u540c\u65f6\u5c06 FAST-LIO2 \u548c SysNav \u4f5c\u4e3a\u540e\u7eed\u5b8c\u6574\u5bfc\u822a\u7cfb\u7edf\u5efa\u8bbe\u7684\u53c2\u8003\u3002</p> <p>\u9700\u8981\u6ce8\u610f\uff0c\u524d\u4e09\u7bc7\u8bba\u6587\u4e3b\u8981\u9762\u5411\u591a\u65cb\u7ffc\u98de\u884c\u5668\uff0c\u5176\u5177\u4f53\u8fd0\u52a8\u6a21\u578b\u548c\u4f18\u5316\u7ea6\u675f\u4e0d\u80fd\u76f4\u63a5\u5957\u7528\u4e8e\u963f\u514b\u66fc\u8f66\u8f86\u3002</p>"},{"location":"research/","title":"\u5f85\u66f4\u65b0","text":""},{"location":"ros2/","title":"\u5f85\u66f4\u65b0","text":""},{"location":"tracking/","title":"\u5f85\u66f4\u65b0","text":""},{"location":"tracking/pure-pursuit-experiments/","title":"Pure Pursuit \u8f68\u8ff9\u8ddf\u8e2a\u4e0e\u901f\u5ea6\u89c4\u5212\u5bf9\u6bd4\u5b9e\u9a8c","text":""},{"location":"tracking/pure-pursuit-experiments/#1","title":"1. \u5b9e\u9a8c\u80cc\u666f","text":"<p>\u5bf9\u4e8e\u91c7\u7528\u963f\u514b\u66fc\u8f6c\u5411\u7ed3\u6784\u7684\u65e0\u4eba\u8f66\uff0c\u8def\u5f84\u89c4\u5212\u7b97\u6cd5\u8d1f\u8d23\u751f\u6210\u53c2\u8003\u8def\u5f84\uff0c\u800c\u8f68\u8ff9\u8ddf\u8e2a\u63a7\u5236\u5668\u8d1f\u8d23\u6839\u636e\u8f66\u8f86\u5f53\u524d\u4f4d\u59ff\u8ba1\u7b97\u8f6c\u5411\u6307\u4ee4\uff0c\u4f7f\u8f66\u8f86\u6cbf\u7740\u53c2\u8003\u8def\u5f84\u884c\u9a76\u3002</p> <p>\u672c\u9879\u76ee\u5728 Hybrid A* \u8def\u5f84\u89c4\u5212\u7684\u57fa\u7840\u4e0a\uff0c\u5b9e\u73b0\u4e86 Pure Pursuit\uff08\u7eaf\u8ddf\u8e2a\uff09\u63a7\u5236\u7b97\u6cd5\uff0c\u5e76\u7814\u7a76\u524d\u77bb\u8ddd\u79bb\u3001\u8f6c\u5411\u901f\u7387\u9650\u5236\u4e0e\u884c\u9a76\u901f\u5ea6\u5bf9\u8f68\u8ff9\u8ddf\u8e2a\u6027\u80fd\u7684\u5f71\u54cd\u3002</p>"},{"location":"tracking/pure-pursuit-experiments/#2-pure-pursuit","title":"2. Pure Pursuit \u7b97\u6cd5\u539f\u7406","text":"<p>Pure Pursuit \u662f\u4e00\u79cd\u51e0\u4f55\u8def\u5f84\u8ddf\u8e2a\u65b9\u6cd5\u3002\u63a7\u5236\u5668\u6839\u636e\u8f66\u8f86\u5f53\u524d\u4f4d\u7f6e\uff0c\u5728\u53c2\u8003\u8def\u5f84\u524d\u65b9\u9009\u62e9\u4e00\u5b9a\u8ddd\u79bb\u7684\u76ee\u6807\u70b9\uff0c\u5e76\u8ba1\u7b97\u4f7f\u8f66\u8f86\u671d\u8be5\u76ee\u6807\u70b9\u8fd0\u52a8\u6240\u9700\u7684\u8f6c\u5411\u89d2\u3002</p> <p>\u5728\u7b80\u5316\u8fd0\u52a8\u5b66\u81ea\u884c\u8f66\u6a21\u578b\u4e0b\uff0c\u5e38\u7528\u8f6c\u5411\u5173\u7cfb\u4e3a\uff1a</p> \\[ \\delta=\\arctan\\left(\\frac{2L\\sin\\alpha}{L_d}\\right) \\] <p>\u5176\u4e2d\uff1a</p> <ul> <li>\\(\\delta\\)\uff1a\u524d\u8f6e\u8f6c\u5411\u89d2\u3002</li> <li>\\(L\\)\uff1a\u8f66\u8f86\u8f74\u8ddd\u3002</li> <li>\\(L_d\\)\uff1a\u524d\u77bb\u8ddd\u79bb\u3002</li> <li>\\(\\alpha\\)\uff1a\u8f66\u8f86\u822a\u5411\u4e0e\u76ee\u6807\u70b9\u65b9\u5411\u4e4b\u95f4\u7684\u5939\u89d2\u3002</li> </ul> <p>\u524d\u77bb\u8ddd\u79bb\u5f71\u54cd\u8f66\u8f86\u7684\u8ddf\u8e2a\u884c\u4e3a\u3002\u8f83\u5c0f\u7684\u524d\u77bb\u8ddd\u79bb\u901a\u5e38\u80fd\u591f\u589e\u5f3a\u5c40\u90e8\u8def\u5f84\u8ddf\u8e2a\u80fd\u529b\uff0c\u4f46\u4e5f\u53ef\u80fd\u5e26\u6765\u8f83\u660e\u663e\u7684\u8f6c\u5411\u53d8\u5316\uff1b\u8f83\u5927\u7684\u524d\u77bb\u8ddd\u79bb\u6709\u5229\u4e8e\u5e73\u6ed1\u63a7\u5236\uff0c\u4f46\u53ef\u80fd\u5728\u6025\u5f2f\u5904\u4ea7\u751f\u66f4\u5927\u7684\u8ddf\u8e2a\u504f\u5dee\u3002</p>"},{"location":"tracking/pure-pursuit-experiments/#3","title":"3. \u81ea\u9002\u5e94\u524d\u77bb\u8ddd\u79bb","text":"<p>\u4f20\u7edf Pure Pursuit \u901a\u5e38\u91c7\u7528\u56fa\u5b9a\u524d\u77bb\u8ddd\u79bb\u3002</p> <p>\u672c\u9879\u76ee\u8fdb\u4e00\u6b65\u5f00\u5c55\u4e86\u81ea\u9002\u5e94\u524d\u77bb\u8ddd\u79bb\u5b9e\u9a8c\uff0c\u6839\u636e\u5c40\u90e8\u8def\u5f84\u6761\u4ef6\u8c03\u6574\u76ee\u6807\u70b9\u7684\u9009\u53d6\u8ddd\u79bb\uff0c\u5e76\u4e0e\u56fa\u5b9a\u524d\u77bb\u8ddd\u79bb\u7b56\u7565\u8fdb\u884c\u6bd4\u8f83\u3002</p> <p>\u5728\u5df2\u6709\u53c2\u6570\u626b\u63cf\u5b9e\u9a8c\u4e2d\uff0c\u9488\u5bf9\u4e0d\u540c\u901f\u5ea6\u4e0e\u524d\u77bb\u8ddd\u79bb\u7ec4\u5408\u8fdb\u884c\u4e86 24 \u7ec4\u6d4b\u8bd5\uff0c\u5176\u4e2d 12 \u7ec4\u6ee1\u8db3\u5f53\u65f6\u8bbe\u5b9a\u7684\u6210\u529f\u6761\u4ef6\u3002</p> <p>\u8be5\u7ed3\u679c\u8bf4\u660e\uff0c\u63a7\u5236\u53c2\u6570\u5bf9\u8def\u5f84\u8ddf\u8e2a\u6027\u80fd\u5177\u6709\u660e\u663e\u5f71\u54cd\uff0c\u9700\u8981\u7ed3\u5408\u8f66\u8f86\u901f\u5ea6\u548c\u9053\u8def\u66f2\u7387\u8fdb\u884c\u9009\u62e9\u3002</p>"},{"location":"tracking/pure-pursuit-experiments/#4","title":"4. \u8f6c\u5411\u901f\u7387\u7ea6\u675f\u5b9e\u9a8c","text":"<p>\u5b9e\u9645\u8f66\u8f86\u7684\u524d\u8f6e\u8f6c\u5411\u89d2\u65e0\u6cd5\u77ac\u95f4\u4ece\u4e00\u4e2a\u89d2\u5ea6\u53d8\u5316\u5230\u53e6\u4e00\u4e2a\u89d2\u5ea6\uff0c\u56e0\u6b64\uff0c\u4ec5\u9650\u5236\u6700\u5927\u8f6c\u5411\u89d2\u5e76\u4e0d\u80fd\u5145\u5206\u53cd\u6620\u6267\u884c\u673a\u6784\u7684\u5b9e\u9645\u80fd\u529b\u3002</p> <p>\u672c\u9879\u76ee\u5728\u8fd0\u52a8\u5b66\u4eff\u771f\u4e2d\u5f15\u5165\u6700\u5927\u8f6c\u5411\u901f\u7387\u7ea6\u675f\uff1a</p> \\[ |\\dot{\\delta}|\\leq\\dot{\\delta}_{\\max} \\] <p>\u5e76\u5728\u591a\u79cd\u8f6c\u5411\u901f\u7387\u9650\u5236\u6761\u4ef6\u4e0b\u6d4b\u8bd5\u4e0d\u540c\u63a7\u5236\u7b56\u7565\u3002</p> <p>\u5df2\u6709\u5b9e\u9a8c\u8986\u76d6\u4e94\u79cd\u573a\u666f\u3001\u56db\u79cd\u63a7\u5236\u7b56\u7565\u548c\u4e09\u79cd\u8f6c\u5411\u901f\u7387\u8bbe\u7f6e\uff0c\u5171 60 \u7ec4\u6d4b\u8bd5\uff0c\u5168\u90e8\u6ee1\u8db3\u5f53\u65f6\u8bbe\u5b9a\u7684\u4eff\u771f\u6210\u529f\u6761\u4ef6\u3002</p> <p>\u8fd9\u4e9b\u7ed3\u679c\u521d\u6b65\u9a8c\u8bc1\u4e86\u63a7\u5236\u5668\u5728\u6240\u9009\u573a\u666f\u548c\u53c2\u6570\u4e0b\u7684\u53ef\u6267\u884c\u6027\uff0c\u4f46\u4ecd\u9700\u8981\u8fdb\u4e00\u6b65\u6d4b\u8bd5\u590d\u6742\u969c\u788d\u7269\u4e0e\u66f4\u52a0\u4e25\u683c\u7684\u6267\u884c\u5668\u6a21\u578b\u3002</p>"},{"location":"tracking/pure-pursuit-experiments/#5","title":"5. \u901f\u5ea6\u89c4\u5212\u5bf9\u6bd4\u5b9e\u9a8c","text":"<p>\u4e3a\u4e86\u7814\u7a76\u901f\u5ea6\u8c03\u8282\u5bf9\u8def\u5f84\u8ddf\u8e2a\u7684\u5f71\u54cd\uff0c\u672c\u9879\u76ee\u8bbe\u7f6e\u56db\u79cd\u63a7\u5236\u7b56\u7565\uff1a</p> <ol> <li>\u56fa\u5b9a\u524d\u77bb\u8ddd\u79bb + \u56fa\u5b9a\u901f\u5ea6\u3002</li> <li>\u81ea\u9002\u5e94\u524d\u77bb\u8ddd\u79bb + \u56fa\u5b9a\u901f\u5ea6\u3002</li> <li>\u56fa\u5b9a\u524d\u77bb\u8ddd\u79bb + \u81ea\u9002\u5e94\u901f\u5ea6\u3002</li> <li>\u81ea\u9002\u5e94\u524d\u77bb\u8ddd\u79bb + \u81ea\u9002\u5e94\u901f\u5ea6\u3002</li> </ol> <p>\u5b9e\u9a8c\u5728\u4e94\u79cd\u4eff\u771f\u573a\u666f\u4e0b\u5f00\u5c55\uff0c\u5171\u8ba1 20 \u7ec4\u6d4b\u8bd5\u3002</p>"},{"location":"tracking/pure-pursuit-experiments/#51","title":"5.1 \u5b9e\u9a8c\u7ed3\u679c","text":"\u63a7\u5236\u7b56\u7565 \u5e73\u5747\u8ddf\u8e2a\u8bef\u5dee\uff08cm\uff09 \u5e73\u5747\u6700\u5927\u8bef\u5dee\uff08cm\uff09 \u5e73\u5747\u884c\u9a76\u65f6\u95f4\uff08s\uff09 \u56fa\u5b9a\u524d\u77bb + \u56fa\u5b9a\u901f\u5ea6 1.804 11.85 19.97 \u81ea\u9002\u5e94\u524d\u77bb + \u56fa\u5b9a\u901f\u5ea6 1.815 11.21 19.98 \u56fa\u5b9a\u524d\u77bb + \u81ea\u9002\u5e94\u901f\u5ea6 1.760 9.30 31.96 \u81ea\u9002\u5e94\u524d\u77bb + \u81ea\u9002\u5e94\u901f\u5ea6 1.684 8.59 31.98 <p>\u8fd9 20 \u7ec4\u5b9e\u9a8c\u5728\u6240\u6d4b\u8bd5\u573a\u666f\u4e0e\u53c2\u6570\u8bbe\u7f6e\u4e0b\u5747\u6ee1\u8db3\u6210\u529f\u5224\u636e\uff0c\u672a\u51fa\u73b0\u68c0\u6d4b\u5230\u7684\u78b0\u649e\u3002</p>"},{"location":"tracking/pure-pursuit-experiments/#52","title":"5.2 \u5b9e\u9a8c\u5206\u6790","text":"<p>\u5b9e\u9a8c\u7ed3\u679c\u8868\u660e\uff0c\u52a0\u5165\u81ea\u9002\u5e94\u901f\u5ea6\u8c03\u8282\u540e\uff0c\u8f66\u8f86\u7684\u5e73\u5747\u8ddf\u8e2a\u8bef\u5dee\u548c\u6700\u5927\u8ddf\u8e2a\u8bef\u5dee\u6709\u6240\u964d\u4f4e\u3002</p> <p>\u5176\u4e2d\uff0c\u91c7\u7528\u81ea\u9002\u5e94\u524d\u77bb\u8ddd\u79bb\u4e0e\u81ea\u9002\u5e94\u901f\u5ea6\u76f8\u7ed3\u5408\u7684\u7b56\u7565\u65f6\uff0c\u5e73\u5747\u8ddf\u8e2a\u8bef\u5dee\u4e3a 1.684 cm\uff0c\u5e73\u5747\u6700\u5927\u8bef\u5dee\u4e3a 8.59 cm\uff0c\u5747\u4e3a\u56db\u79cd\u7b56\u7565\u4e2d\u6700\u4f4e\u3002</p> <p>\u4e0e\u56fa\u5b9a\u524d\u77bb\u8ddd\u79bb\u548c\u56fa\u5b9a\u901f\u5ea6\u7684\u57fa\u7ebf\u76f8\u6bd4\uff1a</p> <ul> <li>\u5e73\u5747\u8ddf\u8e2a\u8bef\u5dee\u964d\u4f4e\u7ea6 6.6%\u3002</li> <li>\u5e73\u5747\u6700\u5927\u8bef\u5dee\u964d\u4f4e\u7ea6 27.5%\u3002</li> <li>\u5e73\u5747\u884c\u9a76\u65f6\u95f4\u589e\u52a0\u7ea6 60.1%\u3002</li> </ul> <p>\u8fd9\u8bf4\u660e\u5f53\u524d\u901f\u5ea6\u8c03\u8282\u7b56\u7565\u80fd\u591f\u5728\u6240\u6d4b\u8bd5\u573a\u666f\u4e2d\u6539\u5584\u8ddf\u8e2a\u7cbe\u5ea6\uff0c\u4f46\u4e5f\u4ed8\u51fa\u4e86\u8f83\u5927\u7684\u65f6\u95f4\u6210\u672c\u3002</p> <p>\u540c\u65f6\uff0c\u5355\u72ec\u91c7\u7528\u81ea\u9002\u5e94\u524d\u77bb\u8ddd\u79bb\u5e76\u672a\u5728\u6240\u6709\u6307\u6807\u4e0a\u8868\u73b0\u66f4\u597d\uff0c\u56e0\u6b64\u4e0d\u80fd\u7b80\u5355\u8ba4\u4e3a\u81ea\u9002\u5e94\u53c2\u6570\u5fc5\u7136\u4f18\u4e8e\u56fa\u5b9a\u53c2\u6570\u3002</p>"},{"location":"tracking/pure-pursuit-experiments/#6","title":"6. \u5f53\u524d\u5b9e\u9a8c\u7684\u5c40\u9650\u6027","text":"<p>\u76ee\u524d\u5b9e\u9a8c\u4e3b\u8981\u57fa\u4e8e\u7b80\u5316\u8fd0\u52a8\u5b66\u81ea\u884c\u8f66\u6a21\u578b\u53ca\u6709\u9650\u6570\u91cf\u7684\u4e8c\u7ef4\u6d4b\u8bd5\u573a\u666f\u3002</p> <p>\u56e0\u6b64\uff0c\u4e0a\u8ff0\u7ed3\u679c\u53ea\u80fd\u8bf4\u660e\u6240\u6d4b\u8bd5\u6761\u4ef6\u4e0b\u7684\u8868\u73b0\uff0c\u4e0d\u80fd\u76f4\u63a5\u63a8\u5e7f\u4e3a\u771f\u5b9e\u8f66\u8f86\u5728\u590d\u6742\u73af\u5883\u4e2d\u7684\u63a7\u5236\u6027\u80fd\u3002</p> <p>\u53e6\u5916\uff0c\u76ee\u524d\u4f7f\u7528\u7684\u7ec8\u70b9\u5224\u636e\u5141\u8bb8\u4e00\u5b9a\u7684\u4f4d\u7f6e\u4e0e\u822a\u5411\u8bef\u5dee\uff0c\u5b9e\u9a8c\u4e2d\u7684\u884c\u9a76\u65f6\u95f4\u4e5f\u4e0d\u7b49\u540c\u4e8e\u5b8c\u6210\u7cbe\u786e\u505c\u8f66\u6240\u9700\u7684\u65f6\u95f4\u3002</p> <p>\u540e\u7eed\u9700\u8981\u8fdb\u4e00\u6b65\u5f15\u5165\u8f66\u8f86\u6267\u884c\u5668\u54cd\u5e94\u3001\u590d\u6742\u5730\u56fe\u3001\u6270\u52a8\u6761\u4ef6\u548c\u66f4\u4e30\u5bcc\u7684\u5bf9\u7167\u63a7\u5236\u65b9\u6cd5\u3002</p>"},{"location":"tracking/pure-pursuit-experiments/#7","title":"7. \u540e\u7eed\u7814\u7a76\u65b9\u5411","text":"<p>\u4e0b\u4e00\u9636\u6bb5\u8ba1\u5212\u91cd\u70b9\u5f00\u5c55\uff1a</p> <ul> <li>\u5728 ROS 2 Jazzy \u4e2d\u5b9e\u73b0\u5728\u7ebf Pure Pursuit \u95ed\u73af\u63a7\u5236\u3002</li> <li>\u5bf9\u6bd4\u56fa\u5b9a\u901f\u5ea6\u3001\u66f2\u7387\u81ea\u9002\u5e94\u901f\u5ea6\u4e0e\u5176\u4ed6\u901f\u5ea6\u8c03\u8282\u7b56\u7565\u3002</li> <li>\u7814\u7a76\u6700\u5927\u8f6c\u5411\u901f\u7387\u7ea6\u675f\u4e0b\u7684\u901f\u5ea6\u4e0e\u8f68\u8ff9\u8ddf\u8e2a\u534f\u540c\u89c4\u5212\u3002</li> <li>\u5f15\u5165\u66f4\u590d\u6742\u7684\u969c\u788d\u7269\u573a\u666f\u4e0e\u66f4\u5168\u9762\u7684\u5b9e\u9a8c\u6307\u6807\u3002</li> <li>\u4e0e\u5df2\u6709\u7684\u6210\u719f\u8f68\u8ff9\u8ddf\u8e2a\u63a7\u5236\u5668\u5f00\u5c55\u5bf9\u7167\u5b9e\u9a8c\u3002</li> </ul>"},{"location":"tracking/pure-pursuit-experiments/#8","title":"8. \u603b\u7ed3","text":"<p>\u672c\u9636\u6bb5\u901a\u8fc7\u591a\u573a\u666f C++ \u4eff\u771f\uff0c\u5bf9 Pure Pursuit\u3001\u81ea\u9002\u5e94\u524d\u77bb\u8ddd\u79bb\u3001\u8f6c\u5411\u901f\u7387\u9650\u5236\u4e0e\u901f\u5ea6\u89c4\u5212\u8fdb\u884c\u4e86\u521d\u6b65\u7814\u7a76\u3002</p> <p>\u5b9e\u9a8c\u8868\u660e\uff0c\u5728\u5f53\u524d\u6d4b\u8bd5\u6761\u4ef6\u4e0b\uff0c\u81ea\u9002\u5e94\u901f\u5ea6\u8c03\u8282\u6709\u52a9\u4e8e\u6539\u5584\u8ddf\u8e2a\u8bef\u5dee\uff0c\u4f46\u53ef\u80fd\u663e\u8457\u589e\u52a0\u884c\u9a76\u65f6\u95f4\u3002</p> <p>\u56e0\u6b64\uff0c\u672a\u6765\u7814\u7a76\u9700\u8981\u5728\u8ddf\u8e2a\u7cbe\u5ea6\u3001\u884c\u9a76\u6548\u7387\u3001\u5b89\u5168\u6027\u548c\u8f66\u8f86\u8fd0\u52a8\u7ea6\u675f\u4e4b\u95f4\u8fdb\u4e00\u6b65\u5bfb\u6c42\u5e73\u8861\u3002</p>"}]}